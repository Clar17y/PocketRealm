      "types": "./dist/constants/gameConstants.d.ts",
      "default": "./dist/constants/gameConstants.js"
    },
    "./constants/npcDialogue": {
      "types": "./dist/constants/npcDialogue.d.ts",
      "default": "./dist/constants/npcDialogue.js"
    },
    "./constants/achievementDefinitions": {
      "types": "./dist/constants/achievementDefinitions.d.ts",
      "default": "./dist/constants/achievementDefinitions.js"
    },
    "./constants/expeditionDefinitions": {
      "types": "./dist/constants/expeditionDefinitions.d.ts",
      "default": "./dist/constants/expeditionDefinitions.js"
    },
    "./constants/worldEventTemplates": {
      "types": "./dist/constants/worldEventTemplates.d.ts",
      "default": "./dist/constants/worldEventTemplates.js"
    },
    "./constants/combatActionDefinitions": {
      "types": "./dist/constants/combatActionDefinitions.d.ts",
      "default": "./dist/constants/combatActionDefinitions.js"
    },
    "./constants/combatEffectNames": {
