# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/adventure

# Redis
REDIS_URL=redis://localhost:6379

# Environment
NODE_ENV=development
LOG_LEVEL=debug

# Discord app and guild
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# PocketRealm services
POCKETREALM_API_BASE_URL=http://localhost:4000
POCKETREALM_WEB_BASE_URL=http://localhost:3002
DISCORD_INTERNAL_API_KEY=

# Discord channels
DISCORD_BOT_HEALTH_CHANNEL_ID=
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_SUPPORT_TRIAGE_CHANNEL_ID=
DISCORD_SUPPORT_CATEGORY_ID=
DISCORD_DUELS_CHANNEL_ID=

# Discord roles
DISCORD_PLAYER_ROLE_ID=
DISCORD_VERIFIED_ROLE_ID=

# Optional comma-separated role/channel IDs
DISCORD_SUPPORT_STAFF_ROLE_IDS=
DISCORD_XP_IGNORED_CHANNEL_IDS=
DISCORD_XP_ELIGIBLE_CHANNEL_IDS=

# Optional comma-separated level:roleId mappings, for example 10:123456789012345678
DISCORD_LEVEL_ROLE_MAP=

# Optional comma-separated emojiKey=<customEmoji> mappings, for example duel=<:pr_duel:123456789012345678>
DISCORD_EMOJI_MAP=
