{
  "name": "@pocketrealm/discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rimraf --glob \"dist\" \"src/**/*.js\" \"src/**/*.js.map\" \"src/**/*.d.ts\" \"src/**/*.d.ts.map\" \"**/*.tsbuildinfo\"",
    "dev": "tsx watch src/index.ts",
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "test": "vitest --config tsconfig.json",
    "register-commands": "tsx src/commands/register.ts"
  },
  "dependencies": {
    "@pocketrealm/database": "*",
    "@pocketrealm/shared": "*",
    "discord.js": "^14.16.3",
    "dotenv": "^16.6.1",
    "ioredis": "^5.3.2",
    "pino": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "rimraf": "^6.1.2",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
