# Database (local: 5433 to avoid conflicts, Neon in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pocketrealm
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pocketrealm

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# JWT Secret (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=4000
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Discord integration
DISCORD_INTERNAL_API_KEY=

# Optional: dedicated HMAC secret (min 32 chars) for Discord link codes.
# Falls back to DISCORD_INTERNAL_API_KEY when unset; setting it lets you
# rotate the internal API key independently without invalidating link codes.
DISCORD_LINK_CODE_SECRET=

# Public web base URL used in links generated for Discord (wiki search, etc).
# Must match the Discord bot worker's POCKETREALM_WEB_BASE_URL value.
POCKETREALM_WEB_BASE_URL=http://localhost:3002

# Optional: private Discord webhook fallback for support triage notifications
DISCORD_SUPPORT_TRIAGE_WEBHOOK_URL=

# Environment
NODE_ENV=development
