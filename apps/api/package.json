{
  "name": "@pocketrealm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "rimraf --glob \"dist\" \"build\" \"lib\" \"src/**/*.js\" \"src/**/*.js.map\" \"src/**/*.d.ts\" \"src/**/*.d.ts.map\" \"**/*.tsbuildinfo\"",
    "dev": "tsx watch --exclude \"../web/**\" --exclude \"../web/.next/**\" --exclude \"../**/node_modules/**\" --exclude \"../packages/**/dist/**\" --exclude \"../**/*.tsbuildinfo\" src/index.ts",
    "build": "npm run clean && node scripts/build.cjs",
    "start": "node dist/index.js",
    "test": "vitest",
    "support:export-new": "tsx scripts/export-support-tickets.ts",
    "discord:setup-server": "tsx scripts/setup-discord-server.ts"
  },
  "dependencies": {
    "@pocketrealm/database": "*",
    "@pocketrealm/game-engine": "*",
    "@pocketrealm/shared": "*",
    "@sentry/node": "^10.48.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "eslint": "9.39.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.9.4",
    "socket.io": "^4.8.3",
    "stripe": "^18.5.0",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
