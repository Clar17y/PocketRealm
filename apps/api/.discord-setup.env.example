# One-off Discord server setup credentials.
# Loaded by npm run discord:setup-server from repo root or apps/api.
# The setup script also writes DISCORD_SUPPORT_TRIAGE_WEBHOOK_URL (a secret)
# back into the real .discord-setup.env file instead of printing it.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_AUTOMOD_EXTRA_KEYWORDS=
